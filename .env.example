# Obtain application credentials at https://my.telegram.org/apps.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_DIR=/data
# Comma-separated IDs from the owner-only 'telegram-mcp dialogs' command.
# Empty values deny access. Read and write permissions are independent.
TELEGRAM_READ_DIALOG_IDS=
TELEGRAM_WRITE_DIALOG_IDS=

# Local mode uses a loopback-only published Docker port.
MCP_MODE=local
# Optional locally, required in server mode; generate a random token of at least 32 characters.
MCP_TOKEN=
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[::1]:*
# Browser origins are denied by default; MCP clients normally connect without an Origin header.
MCP_ALLOWED_ORIGINS=
