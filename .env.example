# Obtain application credentials at https://my.telegram.org/apps.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# local or server. Server mode requires MCP_TOKEN and your public hostname below.
MCP_MODE=local
# Optional locally, required in server mode: a random token of at least 32 characters.
MCP_TOKEN=
# On a server, append your hostname, for example: ,mcp.example.com,mcp.example.com:*
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[::1]:*
